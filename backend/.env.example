TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Developer number for downtime alerts (watchdog). Always used for these,
# independent of the dashboard-configured recipient (which only gets
# content-change alerts).
TWILIO_TO_NUMBER=
CHECK_INTERVAL_MINUTES=15

# Watchdog: polls the backend's /health endpoint and texts if it stops responding
WATCHDOG_URL=http://backend:8000/health
WATCHDOG_INTERVAL_SECONDS=30
WATCHDOG_TIMEOUT_SECONDS=10
WATCHDOG_FAILURE_THRESHOLD=3
